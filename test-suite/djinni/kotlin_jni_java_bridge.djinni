@extern "../../support-lib/future.yaml"
@extern "../../support-lib/outcome.yaml"
@extern "vendor/third-party/kotlin_extern.yaml"

# Records, enums and interfaces for the Java <-> Kotlin JNI converters.

kotlin_java_bridge_color = enum {
  red;
  green;
  blue;
}

kotlin_java_bridge_flags = flags {
  first;
  second;
  third;
}

kotlin_java_bridge_leaf = record {
  value: i32;
  name: string;
} deriving(eq)

kotlin_java_bridge_everything = record {
  b: bool;
  eight: i8;
  sixteen: i16;
  thirtytwo: i32;
  sixtyfour: i64;
  fthirtytwo: f32;
  fsixtyfour: f64;
  text: string;
  data: binary;
  when: date;
  maybe: optional<i32>;
  maybe_text: optional<string>;
  maybe_leaf: optional<kotlin_java_bridge_leaf>;
  items: list<kotlin_java_bridge_leaf>;
  names: list<string>;
  keys: set<string>;
  table: map<string, kotlin_java_bridge_leaf>;
  nested: map<string, list<kotlin_java_bridge_leaf>>;
  leaf_set: set<kotlin_java_bridge_leaf>;
  color_set: set<kotlin_java_bridge_color>;
  leaf_array: array<kotlin_java_bridge_leaf>;
  color_table: map<kotlin_java_bridge_color, kotlin_java_bridge_leaf>;
  color: kotlin_java_bridge_color;
  maybe_color: optional<kotlin_java_bridge_color>;
  flags: kotlin_java_bridge_flags;
  maybe_flags: optional<kotlin_java_bridge_flags>;
  leaf: kotlin_java_bridge_leaf;
  other_text: string;
  other_count: i32;
  message: extern_kotlin_message;
} deriving(eq)

kotlin_java_bridge_error = record {
  message: string;
  code: i32;
}

kotlin_java_bridge_listener = interface +j {
  value(value: i32): i32;
  optional(leaf: optional<kotlin_java_bridge_leaf>): optional<string>;
  list(items: list<kotlin_java_bridge_leaf>): list<string>;
  future_value(value: i32): future<i32>;
  future_leaf(leaf: kotlin_java_bridge_leaf): future<kotlin_java_bridge_leaf>;
  future_outcome(value: i32): future<outcome<kotlin_java_bridge_leaf, kotlin_java_bridge_error>>;
  failed_leaf_future(): future<kotlin_java_bridge_leaf>;
  outcome_value(value: i32): outcome<kotlin_java_bridge_leaf, kotlin_java_bridge_error>;
  chain(other: kotlin_java_bridge_listener, value: i32): i32;
  self(): kotlin_java_bridge_listener;
  listeners(items: list<kotlin_java_bridge_listener>): list<kotlin_java_bridge_listener>;
  maybe_listener(value: optional<kotlin_java_bridge_listener>): optional<kotlin_java_bridge_listener>;
}

# C++ and Kotlin can implement this one.
kotlin_java_bridge_both = interface +c +j {
  ping(leaf: kotlin_java_bridge_leaf): kotlin_java_bridge_leaf;
}

# Containers that need the nested form of the converters.
kotlin_java_bridge_containers = record {
  nested_items: list<list<kotlin_java_bridge_leaf>>;
  nested_table: map<string, map<string, kotlin_java_bridge_leaf>>;
} deriving(eq)

# A +c interface has no converter. The records that hold it, directly or through another record, have none either.
kotlin_java_bridge_service = interface +c {
  value(): i32;
}

kotlin_java_bridge_skipped = record {
  name: string;
  service: optional<kotlin_java_bridge_service>;
}

kotlin_java_bridge_holder = record {
  skipped: kotlin_java_bridge_skipped;
}
