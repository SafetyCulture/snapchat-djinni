@extern "../../support-lib/future.yaml"
@extern "../../support-lib/outcome.yaml"

# Methods of swift_error_bad_service, except fine, break the rule of --swift-error-type CruxError.

crux_error = record {
  message: string;
}

other_error = record {
  message: string;
}

swift_error_bad_service = interface +c {
  plain(): i32;
  nothing();
  wrong_error(): outcome<i32, other_error>;
  load(): future<i32>;
  future_outcome(): future<outcome<i32, crux_error>>;
  fine(): outcome<i32, crux_error>;
}

# An interface with +c and +sw is checked too.
swift_error_bad_shared = interface +c +sw {
  value(): i32;
}

# Methods of a host interface are exempt.
swift_error_bad_observer = interface +o +j +sw {
  on_value(value: i32);
}
