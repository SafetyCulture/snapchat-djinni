@extern "../../support-lib/future.yaml"
@extern "../../support-lib/outcome.yaml"

# Generated with --swift-error-type CruxError and without --swift-async-wrap. Only the methods named in run_djinni.sh break the rules.

crux_error = record {
  message: string;
}

other_error = record {
  message: string;
}

swift_error_bad_service = interface +c {
  plain(): i32;
  nothing();
  wrong_error(): outcome<i32, other_error>;
  load(): future<i32>;
  future_outcome(): future<outcome<i32, crux_error>>;
  future_wrong(): future<outcome<i32, other_error>>;
  fine(): outcome<i32, crux_error>;
}

# The host implements the protocol of an interface with +c and +sw, so its instance methods are exempt. Its static
# methods are checked.
swift_error_bad_shared = interface +c +sw {
  value(): outcome<i32, other_error>;
  static wrong_static(): outcome<i32, other_error>;
}

# Methods of a host interface are exempt.
swift_error_bad_observer = interface +o +j +sw {
  on_value(value: i32);
}
