@extern "../../support-lib/dataref.yaml"
@extern "../../support-lib/dataview.yaml"
@extern "../../support-lib/future.yaml"
@extern "../../support-lib/outcome.yaml"
@extern "vendor/third-party/date.yaml"

# Records and the Sendable conformance that Swift 6 needs.

swift_sendable_kind = enum {
  first;
  second;
}

swift_sendable_flags = flags {
  alpha;
  beta;
}

swift_sendable_error = record {
  message: string;
} deriving(eq, error)

swift_sendable_service = interface +c +sw {
  ping();
}

# All fields are Sendable, so Swift checks the conformance.
swift_sendable_plain = record {
  count: i32;
  name: optional<string>;
  tags: list<string>;
  scores: map<string, f64>;
  when: date;
  bytes: binary;
  kind: swift_sendable_kind;
  flags: swift_sendable_flags;
}

swift_sendable_nested = record {
  plain: swift_sendable_plain;
  items: list<swift_sendable_plain>;
}

# A DataRef field: the generator trusts the conformance.
swift_sendable_with_data = record {
  data: DataRef;
}

# A record that holds a trusted record is Sendable, because that record conforms.
swift_sendable_outer = record {
  inner: swift_sendable_with_data;
}

# A trusted type inside a container.
swift_sendable_with_optional_data = record {
  data: optional<DataRef>;
}

swift_sendable_with_view_list = record {
  views: list<DataView>;
}

swift_sendable_with_data_map = record {
  by_id: map<string, DataRef>;
}

# An interface is only allowed inside a container.
swift_sendable_with_optional_service = record {
  service: optional<swift_sendable_service>;
}

swift_sendable_with_service_list = record {
  services: list<swift_sendable_service>;
}

# An outcome is Sendable when its arguments are.
swift_sendable_with_outcome = record {
  result: outcome<i32, swift_sendable_error>;
}

swift_sendable_with_outcome_data = record {
  result: outcome<DataRef, swift_sendable_error>;
}

# An extern type from yaml that is not protobuf has no known mapping.
swift_sendable_with_extern = record {
  created_at: extern_date;
}

# deriving(sendable) adds nothing to Swift.
swift_sendable_derived = record {
  count: i32;
} deriving(sendable)
