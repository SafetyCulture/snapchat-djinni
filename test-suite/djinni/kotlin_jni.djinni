@import "common.djinni"

@import "enum_flags.djinni"
@import "constant_enum.djinni"
@import "data_ref_view.djinni"

@import "vendor/third-party/date.djinni"
@import "third-party/duration.djinni"
@import "third-party/outcome.djinni"

# Cases for the Kotlin JNI classes.
kotlin_jni_arrays = record {
  # A dollar sign in a string constant needs an escape in Kotlin.
  const dollar: string = "a$b";
  bin: binary;
  nums: array<i32>;
  name: string;
} deriving(eq)

# A Kotlin interface with constants of different kinds.
kotlin_jni_listener = interface +j {
  const count: i32 = 3;
  const label: optional<string> = "label";
  on_event(value: i32);
}

# C++ implements this one. The parameter name must not collide with the members of the generated proxy.
kotlin_jni_proxy = interface +c {
  static create(): kotlin_jni_proxy;
  mark(destroyed: bool): bool;
}
