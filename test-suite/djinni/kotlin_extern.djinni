@extern "vendor/third-party/kotlin_extern.yaml"

# Extern records with and without the Kotlin keys. The Kotlin JNI classes and the JNI code use the Kotlin class of
# an extern record that has the keys.
kotlin_extern_record = record {
  plain: extern_plain_message;
  keyed: extern_kotlin_message;
  keyed_list: list<extern_kotlin_message>;
  keyed_optional: optional<extern_kotlin_message>;
} deriving(eq)

kotlin_extern_service = interface +c {
  static echo(m: extern_kotlin_message): extern_kotlin_message;
  static echo_plain(m: extern_plain_message): extern_plain_message;
  static echo_record(r: kotlin_extern_record): kotlin_extern_record;
}
