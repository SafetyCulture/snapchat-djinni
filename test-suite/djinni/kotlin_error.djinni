@import "kotlin_error_types.djinni"

# C++ implements this one. Its methods cover each kind of return type, without futures, so the functions stay blocking.
kotlin_error_service = interface +c {
  static create(): kotlin_error_service;
  static parse(text: string): outcome<kotlin_error_item, kotlin_error_error>;
  static version(): string;
  ping();
  count(): i32;
  find(id: string): optional<kotlin_error_item>;
  fetch(id: string): outcome<kotlin_error_item, kotlin_error_error>;
  fetch_optional(id: string): outcome<optional<kotlin_error_item>, kotlin_error_error>;
  child(): kotlin_error_service;
  # Parameters with the names of Kotlin keywords and of the locals of the wrapper.
  names(in: i32, val: i32, it: i32): list<string>;
  watch(listener: kotlin_error_listener);
  both(both: kotlin_error_both): kotlin_error_both;
  # The names and the types of members of Any: the functions override them.
  to_string(): string;
  hash_code(): i32;
}
