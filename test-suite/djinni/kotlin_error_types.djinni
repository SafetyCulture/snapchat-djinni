@extern "../../support-lib/outcome.yaml"

# Types of the --kotlin-error-type cases kotlin_error and kotlin_error_async.

kotlin_error_error = record {
  message: string;
}

kotlin_error_item = record {
  id: string;
  count: i32;
}

# Kotlin implements this one, so the flag does not change it.
kotlin_error_listener = interface +j {
  on_item(item: kotlin_error_item): bool;
}

# C++ and Kotlin implement this one. JNI calls the Kotlin methods by their signature, so they keep the raw form.
kotlin_error_both = interface +c +j {
  fetch(id: string): outcome<kotlin_error_item, kotlin_error_error>;
}
