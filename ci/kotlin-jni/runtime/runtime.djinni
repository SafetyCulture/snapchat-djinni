@extern "../../../support-lib/future.yaml"
@extern "../../../support-lib/outcome.yaml"
@extern "../../../test-suite/djinni/vendor/third-party/kotlin_extern.yaml"

# Types for the Kotlin JNI runtime test. C++ implements the service, and Kotlin implements the listener.

kj_error = record {
  message: string;
  code: i32;
}

kj_constants = record {
  # Integer literals for float constants must become float literals in Kotlin.
  const f32_one: f32 = 1;
  const f64_minus_two: f64 = -2;
}

kj_color = enum {
  red;
  green;
  blue;
}

kj_flags = flags {
  flag_a;
  flag_b;
}

kj_empty_extended = record +j {
}

kj_extended = record +j {
  value: i32;
  name: string;
}

kj_blob = record {
  data: binary;
  nums: array<i32>;
} deriving(eq)

kj_item = record {
  id: string;
  count: i32;
  tags: list<string>;
  note: optional<string>;
} deriving(eq)

# Float fields compare as in Java and C++: -0.0 equals 0.0, and NaN equals nothing.
kj_floats = record {
  f: f32;
  d: f64;
  opt: optional<f64>;
} deriving(eq)

kj_ordered_floats = record {
  f: f32;
  d: f64;
} deriving(eq, ord)

# The extern type has the Kotlin keys, so the JNI code binds its pure Kotlin class.
kj_message_box = record {
  message: extern_kotlin_message;
  more: list<extern_kotlin_message>;
  maybe: optional<extern_kotlin_message>;
} deriving(eq)

kj_listener = interface +j {
  on_value(value: i32): i32;
}

# C++ and Kotlin can implement this one.
kj_both = interface +c +j {
  value(): i32;
}

kj_service = interface +c {
  static create(): kj_service;
  # The number of C++ services that are alive.
  static live_count(): i32;
  add(a: i32, b: i32): i32;
  echo(item: kj_item): kj_item;
  echo_blob(blob: kj_blob): kj_blob;
  echo_message(message: extern_kotlin_message): extern_kotlin_message;
  echo_message_box(box: kj_message_box): kj_message_box;
  divide(a: i32, b: i32): outcome<i32, kj_error>;
  call_listener(listener: kj_listener, value: i32): i32;
  delayed(value: i32, millis: i32): future<i32>;
  pending(): future<i32>;
  failing_future(): future<i32>;
  done(): future<void>;
  complete_pending(value: i32);
  # Calls of pending() that reached C++; a cancelled-before-start call must not count
  pending_started(): i32;
  fail(): i32;
  busy(millis: i32);
  max_concurrent(): i32;
  invert(color: kj_color): kj_color;
  echo_service(service: kj_service): kj_service;
  call_both(both: kj_both): i32;
  make_both(): kj_both;
  # optional<enum> and optional<flags> round trips, both null and set
  invert_opt(color: optional<kj_color>): optional<kj_color>;
  flags_opt(flags: optional<kj_flags>): optional<kj_flags>;
}
