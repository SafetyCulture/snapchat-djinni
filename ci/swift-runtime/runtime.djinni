@extern "../../support-lib/dataref.yaml"
@extern "../../support-lib/future.yaml"
@extern "../../support-lib/outcome.yaml"

# Types for the Swift runtime test. C++ implements the service, and Swift implements the listener.

runtime_color = enum { red; green; blue; }

runtime_listener = interface +o +j +sw {
  on_value(value: i32): i32;
  make_data(): DataRef;
  on_fail(): i32;
  # nil success of an outcome of an optional, from Swift to C++
  on_maybe(flag: bool): outcome<optional<i32>, runtime_error>;
  # The result arrives on another thread after the given time
  delayed_future(value: i32, millis: i32): future<i32>;
  # The Swift host rethrows the C++ error that raise_int or raise_argument gave it
  rethrowing_int(): i32;
  rethrowing_argument(): i32;
  # The Swift host throws an error that holds only a message
  throwing_message(): i32;
  # The Swift host returns a future that fails with the C++ error that raise_int gave it
  failing_future(): future<i32>;
}

runtime_service = interface +c +sw {
  static create(): runtime_service;
  static shared(): runtime_service;
  add(a: i32, b: i32): i32;
  call_listener(listener: runtime_listener, value: i32): i32;
  keep_listener(listener: runtime_listener);
  call_kept_listener(value: i32): i32;
  same_service(): runtime_service;
  data_size(data: DataRef): i32;
  listener_data_sum(listener: runtime_listener): i32;
  # nil success of an outcome of an optional, both directions
  maybe(flag: bool): outcome<optional<i32>, runtime_error>;
  # nil success from the Swift host, read on the C++ side
  listener_maybe(listener: runtime_listener, flag: bool): i32;
  # A date with a sub-second part; the round trip must keep one millisecond
  date_roundtrip(d: date): date;
  # C++ sends an enum value that Swift does not know; Swift must throw, not trap
  unknown_color(): runtime_color;
  # C++ returns a null pointer for an interface that is not optional; Swift must throw, not trap
  static null_service(): runtime_service;
  # C++ strings that are not valid UTF-8, and a string with a byte order mark; Swift must throw for the first
  # and keep the mark of the second
  invalid_string(): string;
  bom_string(): string;
  # A record whose first field makes Swift throw, and whose second field holds a reference to kept_data.
  # kept_data_retain_count is the number of references to that data; a failed call must not change it.
  bad_blob(): runtime_blob;
  kept_data_retain_count(): i32;
  # The host rethrows the C++ error, and C++ catches its type. Each method returns what C++ saw.
  call_rethrowing_int(listener: runtime_listener): string;
  call_rethrowing_argument(listener: runtime_listener): string;
  call_throwing_message(listener: runtime_listener): string;
  call_failing_future(listener: runtime_listener): string;
  # A C++ error for the host to carry back to C++.
  raise_int(): i32;
  raise_argument(): i32;
}

runtime_blob = record {
  color: runtime_color;
  data: DataRef;
}

runtime_error = record {
  message: string;
  code: i32;
} deriving(eq, error)

# C++ implements this interface and Swift calls it through the async wrapper.
runtime_async = interface +c {
  static create(): runtime_async;
  add(a: i32, b: i32): i32;
  divide(a: i32, b: i32): outcome<i32, runtime_error>;
  delayed(value: i32, millis: i32): future<i32>;
  pending(): future<i32>;
  complete_pending(value: i32);
  # Calls of pending() that reached C++; a task that is cancelled before the call must not count
  pending_started(): i32;
  # C++ calls the listener on the thread of the call.
  call_listener(listener: runtime_listener, value: i32): i32;
  # --swift-sync-method gives this registration a synchronous form. C++ stores the listener and the thread of the call.
  register_listener(listener: runtime_listener): i32;
  # A listed registration with two parameters of the same type: the synchronous form must pass them in order.
  record_pair(first: i32, second: i32): i32;
  # The two values that record_pair stored, as "first,second".
  recorded_pair(): string;
  # The mach thread id of the register_listener call.
  registration_thread(): i64;
  # Calls the listener that register_listener stored.
  call_registered_listener(value: i32): i32;
  # A future with a +sw parameter that is not listed: it gets no synchronous form.
  observe(listener: runtime_listener): future<i32>;
  static shared(): runtime_async;
  same(): runtime_async;
  busy(millis: i32);
  fail_future(): future<i32>;
  max_concurrent(): i32;
  # A future whose promise C++ drops without a value
  dropped(): future<i32>;
  # A future that C++ fulfils with an enum value that Swift does not know; the conversion of the value must fail the future
  bad_color_future(): future<runtime_color>;
  # C++ chains a handler that throws an exception outside std::exception to the future of a Swift host
  describe_future_failure(listener: runtime_listener): string;
  # These methods throw a C++ exception.
  fail(): i32;
  fail_void();
  fail_outcome(): outcome<i32, runtime_error>;
  fail_unknown(): i32;
  # C++ catches the exception that the Swift listener throws, and returns its message.
  describe_listener_failure(listener: runtime_listener): string;
}
