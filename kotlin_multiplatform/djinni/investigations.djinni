@extern "extern/incidents.djinni.yaml"
@extern "extern/investigation.djinni.yaml"

# Investigations API
investigations_API = interface +c {
  static create(): investigations_API;

  list_investigations(load_mode: load_mode, request: pb_incidents_Incidents_ListInvestigationsRequest): list_investigations_result;
}

list_investigations_result = record {
  items: list<pb_incidents_Investigation_InvestigationListItem>;
  next_page_token: optional<string>;
  error: optional<GRPC_status_code>;
}
