@extern "extern/s12/tasks/v1/incident.djinni.yaml"
@extern "extern/s12/tasks/v1/incidents.djinni.yaml"
@extern "extern/s12/tasks/v1/task.djinni.yaml"
@extern "extern/s12/tasks/v1/timeline_item_message.djinni.yaml"

@import "crux_generated/incidents_grpc_services.djinni"

# Incidents API
incidents_API = interface +c {

  # Create API
  static create(): incidents_API;

  # Get weather data for an incident
  get_weather(incident_id: string): get_weather_response;

  # Add comment to timeline
  add_comment(incident_id: string, comment: string);

  # Add media to timeline
  add_media(incident_id: string, media_items: list<media_item>);

  # Set site to an incident
  set_site(incident_id: string, site_id: string, site_name: string);

  # Clear site of an incident
  clear_site(incident_id: string);

  # Set title of an incident
  update_title(incident_id: string, title: string);

  # Set description of an incident
  update_description(incident_id: string, description: string);

  # Set due date of an incident
  update_due_date(incident_id: string, due_date: optional<date>);

  # Set assignee to an incident, if there is previous assignee, please use replace_assignee()
  set_assignee(incident_id: string, assignee: pb_tasks_Task_Task_Collaborator);

  # Clear assignee to an incident
  clear_assignee(incident_id: string, assignee: pb_tasks_Task_Task_Collaborator);

  # Replace old assignee with new one
  replace_assignee(incident_id: string, old_assignee: pb_tasks_Task_Task_Collaborator, new_assignee: pb_tasks_Task_Task_Collaborator);

  # Set category to an incident
  update_category(incident_id: string, category_id: string, category_label: string);

  # Set priority to an incident
  update_priority(incident_id: string, priority_id: string);

  # Set status to an incident
  update_status(incident_id: string, status_id: string);

  # Delete an incident
  delete_incident(incident_id: string);

  # Get list of categories
  get_categories(load_mode: load_mode): list<pb_tasks_Incident_Category>;

  # Get list of custom questions and answers per category
  get_questions_and_answers(incident_id: string, category_id: string, load_mode: load_mode): list<pb_tasks_Incident_QuestionAndAnswers>;

  # Update category name
  update_category_name(category_id: string, name: string);

  # Update category visibility
  update_category_visibility(category_id: string, is_visible: bool);

  # Share an incident with users, external users or groups
  share_incident(incident_id: string, recipients: task_sharing_recipients, is_critical_alert_enabled: bool);

  # Retrieve the list of incidents with the given modifiers.
  get_incidents(load_mode: load_mode, request: pb_tasks_Incidents_GetIncidentsRequest): incidents_response;

  # Retrieve the current incident.
  get_incident(incident_id: string, load_mode: load_mode): incident_response;

  # Retrieve the timeline for a given incident.
  get_timeline(incident_id: string, load_mode: load_mode): incident_timeline_response;

  # Get external config url to share incident.
  get_incident_external_config(incident_id: string): incident_external_config_response;

  # Create external config url to share incident.
  create_incident_external_config(incident_id: string): incident_external_config_response;

  # Revoke external config url
  revoke_incident_external_config(incident_id: string): GRPC_status_code;

  # Add answer to a text question
  add_answer(incident_id: string, question_id: string, answer: string, question_text: optional<string>);

  # Add answer to a multiple choice question
  add_multiple_choice_answer(incident_id: string, question_id: string, answer_text: string, answer_id: string, question_text: optional<string>);

  # Get all cached categories maintained by the sync engine, fetches from remote if cache miss and fetch_from_remote_if_cache_miss is true
  get_all_categories(fetch_from_remote_if_cache_miss: bool): list<pb_tasks_Incident_Category>;

  # Create an incident with required fields
  submit_incident(request: pb_tasks_Incidents_SubmitIncidentRequest, is_report_only: bool);

  # Update location associated to an incident
  update_incident_location(request: pb_tasks_Incidents_UpdateLocationRequest);

  # Update 'occurred_at' field associated to an incident
  update_incident_occurred_at(request: pb_tasks_Incidents_UpdateOccurredAtRequest);
}

incidents_response = record {
  incidents: list<pb_tasks_Incident_Incident>;
  next_page_token: optional<string>;
  error: optional<tasks_API_error>;
}

incident_response = record {
  incident: optional<pb_tasks_Incident_Incident>;
  error: optional<tasks_API_error>;
}

get_weather_response = record {
  weatherProperties: list<pb_tasks_Incident_DeviceReading>;
  error: optional<tasks_API_error>;
}

incident_timeline_response = record {
  items: list<pb_tasks_TimelineItemMessage_TimelineItem>;
  error: optional<tasks_API_error>;
}

task_sharing_recipients = record {
  users: list<pb_tasks_Task_Task_User>;
  external_users: list<pb_tasks_Task_Task_ExternalUser>;
  groups: list<pb_tasks_Task_Task_Group>;
}

incident_external_config_response = record {
  config: optional<pb_tasks_Incident_IssueExternalConfig>;
  status_code: GRPC_status_code;
}
