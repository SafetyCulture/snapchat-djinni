load_mode = enum {
  # Load object from remote.
  load_remote;
  # Load object from cache.
  load_cache;
}

# GRPC status code mapping
GRPC_status_code = enum {
  ok;
  cancelled;
  unknown;
  invalid_argument;
  deadline_exceeded;
  not_found;
  already_exists;
  permission_denied;
  unauthenticated;
  resource_exhausted;
  failed_precondition;
  aborted;
  out_of_range;
  unimplemented;
  internal;
  unavailable;
  data_loss;
  do_not_use;
}