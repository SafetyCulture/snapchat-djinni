primitives_record = record {
    aByte: i8;
    aShort: i16;
    anInt: i32;
    aLong: i64;
    aString: string;
    aBool: bool;
    aDate: date;
    aList: list<string>;
    aMap: map<string, string>;
    aSet: set<string>;
}

user = record {
   firstName: string;
   lastName: string;
   createdAt: date;
}

group = record {
  users: list<user>;
}

load_mode = enum {
    remote;
    cache;
}

users_API = interface +c {
    static create(): users_API;

    get_group(load_mode: load_mode, group_id: string): group;
}